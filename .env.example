# All paths are relative to the repository unless made absolute.
GMAIL_CLIENT_SECRETS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=data/gmail-token.json
RAG_DB_PATH=data/stage1.sqlite3

# This model is downloaded once, then runs locally through sentence-transformers.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Ollama must be running locally. No hosted LLM endpoint is supported by this app.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

